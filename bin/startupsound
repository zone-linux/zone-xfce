#!/bin/bash
set -euo pipefail

DIR="/usr/share/sounds/zone"

if [[ "$1" == "--login" ]]; then
  mpv --no-video "$DIR/pda_news.ogg"
elif [[ "$1" == "--logout" ]]; then
  mpv --no-video "$DIR/pda_objective.ogg"
elif [[ "$1" == "--random" ]]; then
  find "$DIR" -maxdepth 1 -name '*.ogg' | shuf -n 1 | while IFS= read -r file; do
    mpv --no-video "$file"
  done
else
  echo "
  Available Options:
    --login
    --logout
    --random
  "
fi
